{
  "name": "glimpse-cli",
  "version": "0.2.5",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.3.14"
  },
  "bin": {
    "glimpse": "./dist/cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjesuiter/glimpse-cli.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    "skills"
  ],
  "scripts": {
    "build": "tsdown",
    "build:binary": "bun scripts/build-binaries.ts --current",
    "build:binaries": "bun scripts/build-binaries.ts",
    "prepack": "bun run build >/dev/null",
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts tsdown.config.ts",
    "lint:fix": "oxlint src test scripts tsdown.config.ts --fix",
    "format": "oxfmt src test scripts package.json tsconfig.json tsdown.config.ts",
    "format:check": "oxfmt src test scripts package.json tsconfig.json tsdown.config.ts --check",
    "start": "bun src/cli.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "evlog": "^2.19.1",
    "glimpseui": "^0.8.1",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  }
}
